# FFmpeg binaries.
# This machine has two Homebrew ffmpeg builds installed: `ffmpeg` (lean, no
# libass) and `ffmpeg-full` (has libass). `brew link --overwrite ffmpeg-full`
# makes the bare name correct, but a future `brew upgrade` can relink the lean
# one. If startup reports the subtitles filter missing, set an absolute path:
#   FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

HOST=127.0.0.1
PORT=8000

# --- Phase 6: clip discovery ---
# Local-only via Ollama. No cloud key is ever required.
#   ollama serve
#   ollama pull qwen3:8b
LLM_PROVIDER=auto
# LLM_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434

# Transcript tokens per model call. Lower it if the model's context is small
# or generation is slow; raise it for better cross-topic awareness.
LLM_WINDOW_TOKENS=1800
CANDIDATES_PER_WINDOW=3

# Ollama picks a context window from available VRAM and may choose 4096.
# num_ctx covers prompt AND generation; if it is too small Ollama silently
# drops the oldest tokens - the transcript - and the model answers about text
# it never saw. Set it explicitly.
LLM_NUM_CTX=8192
LLM_MAX_OUTPUT=768

# Reasoning models (qwen3, deepseek-r1) think before answering. Ollama keeps
# that in a separate field so it never reaches the JSON parser, but it still
# costs seconds and still counts against the output budget - a long think can
# truncate the answer after it. Off by default for structured extraction.
LLM_THINK=0

# Optional cloud providers. Nothing in the app requires these.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
