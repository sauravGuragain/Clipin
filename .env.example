# FFmpeg binaries.
# This machine has two Homebrew ffmpeg builds installed: `ffmpeg` (lean, no
# libass) and `ffmpeg-full` (has libass). `brew link --overwrite ffmpeg-full`
# makes the bare name correct, but a future `brew upgrade` can relink the lean
# one. If startup reports the subtitles filter missing, set an absolute path:
#   FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

HOST=127.0.0.1
PORT=8000

# Phase 6+. Local-only via Ollama; no cloud keys needed.
# OLLAMA_HOST=http://127.0.0.1:11434
